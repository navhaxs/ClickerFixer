<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" Width="360" Height="420"
        x:Class="ClickerFixer.Desktop.SettingsWindow"
        Title="ClickerFixer - Settings"
        ShowInTaskbar="True">
    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="8">
        <TextBlock Grid.Row="0"
                   Margin="0 0 0 8"
                   TextWrapping="Wrap"
                   Text="Target priority - the first target below whose app is running/active receives clicker input. Reorder with the buttons." />

        <ListBox Name="TargetsListBox" Grid.Row="1" />

        <TextBlock Name="NativeOrderWarning"
                   Grid.Row="2"
                   Margin="0 8 0 0"
                   TextWrapping="Wrap"
                   Foreground="Orange"
                   IsVisible="False"
                   Text="'send key events' (Native) always reports as active, so anything below it can never be reached. Move it to the bottom." />

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0 8 0 0">
            <Button Content="Move Up" Click="MoveUpButtonClicked" />
            <Button Content="Move Down" Click="MoveDownButtonClicked" />
            <Button Content="Save" Click="SaveButtonClicked" HorizontalAlignment="Right" />
        </StackPanel>
    </Grid>
</Window>
