# deploy/clicker.service
# Install: sudo cp deploy/clicker.service /etc/systemd/system/clicker.service
#          sudo systemctl daemon-reload
#          sudo systemctl enable --now clicker.service
[Unit]
Description=ClickerFixerApp
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=30
ExecStart=/opt/clicker-fixer-app/ClickerFixer.Satellite
WorkingDirectory=/opt/clicker-fixer-app
User=pi
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
